{
  "name": "pulsobyte",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "description": "PulsoByte — Tecnologia sem ruído. Portal editorial de tecnologia.",
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:catalog && npm run validate:content && npm run validate:images && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/",
    "catalog:generate": "node scripts/generate-editorial-catalog.mjs",
    "validate:catalog": "node scripts/generate-editorial-catalog.mjs --check",
    "validate:content": "node scripts/validate-article-content-v2.mjs",
    "validate:images": "node scripts/validate-article-images.mjs",
    "smoke:production": "node scripts/smoke-test-production.mjs"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "next": "^15.3.4",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.10",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.29.0",
    "eslint-config-next": "^15.3.4",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.8.3"
  }
}
