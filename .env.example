# URL pública do portal (canonical, sitemap, robots, Open Graph e JSON-LD).
# Ausente ou vazia: usa o domínio de produção confirmado em
# automation/editorial-config.json (site.productionUrl).
# Só defina outro valor quando o domínio estiver realmente conectado ao
# projeto na Vercel — a URL precisa ser HTTPS, sem caminho e sem barra final.
NEXT_PUBLIC_SITE_URL=

# ID de editor do Google AdSense (formato ca-pub-0000000000000000).
# Ausente: usa o ID padrão do portal documentado no README (AdSense ativo).
# Vazio (NEXT_PUBLIC_ADSENSE_CLIENT=): AdSense completamente desativado.
# Fora do formato: o build falha com mensagem explicando o problema.
NEXT_PUBLIC_ADSENSE_CLIENT=
